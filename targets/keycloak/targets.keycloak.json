        "steps": [
          {
            "script": "keycloak.steps.mjs#accedi",
            "args": {
              "user": "u-profile"
            }
          },
          {
            "scan": "form"
          },
          {
            "click": "input[type=submit], button[type=submit]",
            "wait": "load"
          },
          {
            "scan": "errori"
          }
        ]
      },
      {
        "name": "verify-email",
