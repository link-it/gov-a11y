      {
        "name": "username-password",
        "start": "/realms/a11y-test/protocol/openid-connect/auth?client_id=a11y-uf&response_type=code&scope=openid&redirect_uri=http%3A%2F%2F127.0.0.1%3A8090%2Frealms%2Fa11y-test%2F.well-known%2Fopenid-configuration",
