        "steps": [
          {
            "script": "keycloak.steps.mjs#confermaCodiciRecupero",
            "args": {
              "user": "u-recovery"
            }
          },
          {
            "script": "keycloak.steps.mjs#accedi",
            "args": {
              "user": "u-recovery"
            }
          },
          {
            "scan": "pagina"
          },
          {
            "fill": {
              "selector": "#recoveryCodeInput",
