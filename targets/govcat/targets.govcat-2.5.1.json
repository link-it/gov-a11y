  "govcat-anonimo": {
    "name": "govcat-anonimo",
    "enabled": false,
    "$enabledNote": "Da abilitare solo sui server che accettano le richieste anonime (ANONYMOUS_ACCESS in app-config.json e backend con accesso anonimo): altrimenti la configurazione remota risponde 401 e le viste ricadono sulla pagina di accesso.",
    "loginPath": "/auth/login",
    "contextPath": "/",
    "sourceHint": "frontend/angular/projects/apicat-app/src",
    "navWait": "domcontentloaded",
    "navDelayMs": 8000,
    "postLogin": {
      "steps": [
        { "goto": "/auth/login", "wait": "domcontentloaded", "delayMs": 5000 },
        { "clickText": "Continua a navigare in modalità anonima", "optional": true, "timeoutMs": 5000, "delayMs": 5000, "desc": "catalogo anonimo" }
      ]
    },
    "pages": [
      { "name": "catalogo-anonimo", "path": "/servizi" }
    ],
    "flows": [
      {
        "name": "anonimo-vetrina",
        "start": "/servizi",
        "skipIfMissing": ".card:not(.group) h2.card-title",
        "skipIfMissingTimeoutMs": 60000,
        "sourceHint": "frontend/angular/projects/apicat-app/src/views/servizi",
        "steps": [
          { "click": "ui-search-bar-form button[name='options']", "optional": true, "delayMs": 1500, "desc": "modulo di ricerca" },
          { "scan": "anonimo-ricerca" },
          { "goto": "/servizi", "wait": ".card", "timeoutMs": 60000, "delayMs": 3000 },
          { "click": ".card.group h2.card-title, .card.group", "optional": true, "delayMs": 4000, "desc": "apri un gruppo" },
          { "scan": "anonimo-gruppo" },
          { "goto": "/servizi", "wait": ".card", "timeoutMs": 60000, "delayMs": 3000 },
          { "click": ".card:not(.group) h2.card-title", "wait": "main h1", "timeoutMs": 30000, "delayMs": 3000, "desc": "vetrina del primo servizio" },
          { "scan": "anonimo-vetrina" },
          { "click": "lnk-api-row", "optional": true, "delayMs": 4000, "desc": "dettaglio di una API" },
          { "scan": "anonimo-vetrina-api" }
        ]
      }
    ]
  },
  "govcat-moduli": {
    "name": "govcat-moduli",
    "$optionalNote": "Moduli che dipendono dalla configurazione (tassonomie, monitoraggio generale e servizi generici dal server, questi ultimi con servizio.generico.abilitato; notifiche dall'app-config: AppConfig.Layout.showNotificationsBar o showNotificationsMenu, con Layout.dashboard.enabled=false, perché la dashboard le nasconde). Le loro viste sono 'optional': dove il modulo è spento la rotta rimanda a /servizi, analizzata per prima proprio per riconoscere il rimando, e la vista resta nel perimetro come opzionale senza far fallire il gate (failOnSkipped).",
    "loginPath": "/",
    "contextPath": "/",
    "sourceHint": "frontend/angular/projects/apicat-app/src",
    "extraHTTPHeaders": {
      "X-GovCat-principal": "${A11Y_GOVCAT_PRINCIPAL}"
    },
    "navWait": "domcontentloaded",
    "navDelayMs": 8000,
    "postLogin": {
      "steps": [
        { "goto": "/servizi", "wait": "domcontentloaded", "delayMs": 8000, "desc": "trigger select-org" },
        { "clickText": "Ministero Interno", "optional": true, "timeoutMs": 10000, "delayMs": 700, "desc": "scegli org (solo se l'utente ha più organizzazioni)" },
        { "clickText": "Conferma", "optional": true, "timeoutMs": 2000, "delayMs": 2500, "desc": "conferma org" }
      ]
    },
    "pages": [
      { "name": "moduli-servizi", "path": "/servizi", "$comment": "riferimento: le rotte dei moduli spenti rimandano qui e risultano non analizzate invece di essere scambiate per la lista dei servizi" },
      { "name": "tassonomie", "path": "/tassonomie", "optional": true },
      { "name": "monitoraggio", "path": "/monitoraggio", "optional": true },
      { "name": "notifiche", "path": "/notifications", "optional": true },
      { "name": "servizi-generici", "path": "/servizi-generici", "optional": true }
    ],
    "flows": [
      {
        "name": "tassonomia-dettaglio-categorie",
        "optional": true,
        "start": "/tassonomie",
        "skipIfMissing": ".item-row-link",
        "skipIfMissingTimeoutMs": 60000,
        "sourceHint": "frontend/angular/projects/apicat-app/src/views/taxonomies",
